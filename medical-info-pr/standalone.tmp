<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#7b52ff" />
  <meta name="color-scheme" content="light" />
  <meta name="referrer" content="no-referrer" />
  <meta name="description" content="テーマと参考資料から、ChatGPTで院内広報のMASTER原稿を設計し、RENDERで1枚ずつ画像化するブラウザツール。" />
  <title>広報クエスト｜院内広報メーカー</title>
  <style>
:root{
  --ink:#1f2454;--muted:#666d8a;--purple:#7651ff;--violet:#b056ff;--pink:#ee5db3;--orange:#ff9b42;--yellow:#ffd653;--blue:#4aa7ff;--cyan:#57d6e8;--green:#38b980;--paper:#fffdfb;--line:rgba(53,48,99,.12);--shadow:0 26px 70px rgba(72,48,128,.11);--radius:28px;--safe-bottom:max(18px,env(safe-area-inset-bottom));
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:"Hiragino Sans","Yu Gothic UI","Yu Gothic",Meiryo,sans-serif;color:var(--ink);background:linear-gradient(180deg,#fffdfb 0,#fff 35%,#faf8ff 100%);line-height:1.7;overflow-x:hidden}.skip-link{position:fixed;left:12px;top:-70px;z-index:999;background:#fff;color:var(--ink);padding:10px 14px;border-radius:10px;box-shadow:var(--shadow)}.skip-link:focus{top:12px}button,input,textarea,summary,a{font:inherit}button{touch-action:manipulation}button:focus-visible,input:focus-visible,textarea:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid rgba(83,134,255,.6);outline-offset:3px}.cursor-glow{position:fixed;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(142,105,255,.11),transparent 67%);transform:translate(-50%,-50%);pointer-events:none;z-index:-1}.ambient-orb{position:fixed;border-radius:50%;filter:blur(10px);opacity:.35;pointer-events:none;z-index:-2}.orb-1{width:330px;height:330px;background:#c9bbff;left:-120px;top:80px}.orb-2{width:300px;height:300px;background:#ffd0e6;right:-100px;top:360px}.orb-3{width:260px;height:260px;background:#c9f4ff;left:48%;bottom:-110px}.topbar{position:fixed;z-index:80;top:0;left:0;right:0;display:flex;align-items:center;gap:24px;padding:16px clamp(20px,5vw,76px);padding-top:max(16px,env(safe-area-inset-top));background:rgba(255,253,251,.77);backdrop-filter:blur(20px);border-bottom:1px solid transparent;transition:.25s}.topbar.scrolled{border-color:var(--line);box-shadow:0 10px 30px rgba(69,48,116,.06)}.brand{display:flex;align-items:center;gap:10px;text-decoration:none;color:var(--ink);font-weight:950;font-size:19px;white-space:nowrap}.brand-icon{width:35px;height:35px;border-radius:12px;background:linear-gradient(135deg,var(--purple),var(--pink),var(--orange));color:white;display:grid;place-items:center;box-shadow:0 8px 20px rgba(118,81,255,.22)}.desktop-nav{display:flex;gap:26px;margin-left:auto}.desktop-nav a{color:#4f5576;text-decoration:none;font-size:13px;font-weight:800}.top-cta{border:0;color:white;background:linear-gradient(135deg,var(--purple),#9c47f5);padding:10px 17px;border-radius:999px;font-weight:900;cursor:pointer;box-shadow:0 9px 23px rgba(118,81,255,.24)}
.hero{min-height:100svh;display:grid;grid-template-columns:minmax(410px,.86fr) minmax(500px,1.14fr);align-items:center;gap:20px;padding:130px clamp(28px,5vw,78px) 74px;position:relative;overflow:hidden}.hero-copy{position:relative;z-index:5}.eyebrow{display:inline-flex;align-items:center;gap:8px;padding:8px 13px;background:rgba(255,255,255,.86);border:1px solid rgba(99,77,168,.11);border-radius:999px;color:#754ddb;font-size:13px;font-weight:900;box-shadow:0 10px 26px rgba(95,69,158,.07)}.eyebrow span{color:#8f5cff}.hero h1{font-size:clamp(48px,5.2vw,78px);line-height:1.1;letter-spacing:-.045em;margin:22px 0 22px}.gradient-text{background:linear-gradient(90deg,#714cff,#d754d3,#ff8d3d);-webkit-background-clip:text;background-clip:text;color:transparent}.gradient-text.alt{background-image:linear-gradient(90deg,#398cff,#7e57ee,#ec58b4)}.hero-lead{max-width:620px;color:#575e7c;font-size:16px;margin:0}.hero-actions,.master-buttons,.render-actions,.panel-actions{display:flex;flex-wrap:wrap;gap:11px;margin-top:26px}.btn{border:0;border-radius:15px;min-height:50px;padding:0 20px;font-weight:950;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:14px;text-decoration:none;transition:.2s transform,.2s box-shadow,.2s opacity}.btn:hover{transform:translateY(-2px)}.btn-primary{color:white;background:linear-gradient(135deg,#6554ff,#943eff 55%,#dc54bd);box-shadow:0 14px 28px rgba(115,71,240,.24)}.btn-soft{background:white;color:#34395f;border:1px solid rgba(80,70,132,.15);box-shadow:0 10px 24px rgba(75,53,120,.07)}.btn-success{background:linear-gradient(135deg,#24a86f,#49c68d);color:#fff;box-shadow:0 12px 25px rgba(36,168,111,.18)}.text-btn{border:0;background:transparent;color:#737894;font-weight:800;cursor:pointer;padding:10px}.hero-features{display:grid;grid-template-columns:repeat(3,1fr);gap:11px;margin-top:31px;max-width:620px}.hero-features>div{background:rgba(255,255,255,.77);backdrop-filter:blur(12px);border:1px solid rgba(80,67,132,.1);border-radius:18px;padding:13px;display:grid;grid-template-columns:38px 1fr;column-gap:9px;align-items:center;box-shadow:0 12px 30px rgba(76,51,130,.06)}.hero-features b{font-size:13px}.hero-features small{grid-column:2;color:#80849a;font-size:10px}.feature-icon{grid-row:1/3;width:38px;height:38px;border-radius:12px;display:grid;place-items:center;color:#fff;font-weight:950}.feature-icon.purple{background:linear-gradient(135deg,#7550ff,#b256ff)}.feature-icon.orange{background:linear-gradient(135deg,#ff9b3d,#ffc857)}.feature-icon.blue{background:linear-gradient(135deg,#3f93ff,#58d2ef)}
.hero-stage{min-height:650px;position:relative;isolation:isolate}.party-frame{position:absolute;inset:0 -5% -2% -14%;display:grid;align-items:end;z-index:4;pointer-events:none}.party-frame img{width:110%;height:auto;display:block;filter:drop-shadow(0 22px 32px rgba(78,53,130,.12));mix-blend-mode:multiply}.wash{position:absolute;border-radius:50%;filter:blur(12px);opacity:.45;z-index:0}.wash-a{width:480px;height:350px;background:#cbd9ff;right:-55px;top:-10px}.wash-b{width:410px;height:360px;background:#ffd6ee;left:120px;bottom:0}.wash-c{width:360px;height:300px;background:#fff0b4;right:55px;bottom:30px}.float-ui{position:absolute;z-index:7;background:rgba(255,255,255,.76);backdrop-filter:blur(18px);border:1px solid rgba(103,80,160,.11);box-shadow:0 15px 38px rgba(72,51,122,.13);border-radius:16px;padding:10px 13px;display:flex;align-items:center;gap:9px;transform:translate(var(--px,0),var(--py,0));transition:.15s transform}.float-ui>span{width:32px;height:32px;border-radius:10px;display:grid;place-items:center;color:#fff;background:linear-gradient(135deg,#7053ff,#ee5eb6)}.float-ui div{display:grid}.float-ui small{color:#8b8ca3;font-size:9px}.float-ui b{font-size:12px}.ui-master{left:7%;top:16%;animation:floatA 5s ease-in-out infinite}.ui-render{right:1%;top:37%;animation:floatB 6s ease-in-out infinite}.ui-check{right:13%;top:9%;animation:floatA 5.5s ease-in-out infinite}.ui-check>span{background:linear-gradient(135deg,#35c688,#64d9a0)}.ui-chart{left:24%;top:4%;display:grid;grid-template-columns:1fr auto;min-width:150px}.spark-bars{display:flex;align-items:end;gap:3px;height:22px}.spark-bars i{display:block;width:8px;border-radius:5px 5px 2px 2px;background:linear-gradient(#ec60bd,#7e5bff)}.spark-bars i:nth-child(1){height:8px}.spark-bars i:nth-child(2){height:12px}.spark-bars i:nth-child(3){height:16px}.spark-bars i:nth-child(4){height:14px}.spark-bars i:nth-child(5){height:21px}.ui-chart b{grid-column:2;grid-row:1/3;color:#ff9146;font-size:22px}.hero-arrow{position:absolute;width:65%;right:0;top:1%;z-index:2;filter:drop-shadow(0 7px 9px rgba(255,161,60,.18))}.sparkles{position:absolute;inset:0;z-index:3;pointer-events:none}.sparkles i{position:absolute;width:9px;height:9px;border-radius:2px;background:var(--c);transform:rotate(var(--r));animation:spark var(--d) ease-in-out infinite alternate}@keyframes spark{to{transform:translateY(-12px) rotate(calc(var(--r) + 120deg));opacity:.35}}@keyframes floatA{50%{margin-top:-10px}}@keyframes floatB{50%{margin-top:11px}}
.section{padding:100px clamp(22px,6vw,92px);position:relative}.section-heading{max-width:760px;text-align:center;margin:0 auto 44px}.kicker{color:#7c55e8;font-size:11px;letter-spacing:.18em;font-weight:950}.section-heading h2,.safety-card h2,.public-card h2,.ending-copy h2{font-size:clamp(32px,4vw,52px);line-height:1.22;letter-spacing:-.035em;margin:8px 0 10px}.section-heading p,.public-card p,.ending-copy p{color:var(--muted);margin:0}.how{background:linear-gradient(180deg,rgba(255,255,255,.25),#fff7fb 55%,#fff)}.steps-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:19px;max-width:1120px;margin:auto}.step-card{position:relative;min-height:250px;padding:27px;border-radius:26px;background:rgba(255,255,255,.84);border:1px solid rgba(83,65,138,.1);box-shadow:0 22px 55px rgba(74,51,128,.08);transition:.2s transform}.step-no{font-size:11px;letter-spacing:.14em;color:#a89bc8;font-weight:950}.step-art{width:58px;height:58px;border-radius:18px;display:grid;place-items:center;color:#fff;font-size:24px;margin:28px 0 17px}.step-art.purple{background:linear-gradient(135deg,#7050ff,#b456ff)}.step-art.orange{background:linear-gradient(135deg,#ff913e,#ffca51)}.step-art.blue{background:linear-gradient(135deg,#3e91ff,#58d1ef)}.step-card h3{font-size:21px;margin:0 0 7px}.step-card p{font-size:14px;color:var(--muted);margin:0}.safety{padding-top:55px;padding-bottom:55px}.safety-card{max-width:1120px;margin:auto;background:linear-gradient(135deg,#fff9e9,#fff 48%,#f5f0ff);border:1px solid rgba(101,73,159,.11);border-radius:30px;box-shadow:var(--shadow);padding:30px;display:grid;grid-template-columns:auto minmax(0,1fr) minmax(300px,.8fr);align-items:center;gap:22px}.safety-icon{font-size:42px}.safety-card h2{font-size:32px}.safety-card p{color:#5d617a;margin:5px 0 0}.safety-points{display:grid;gap:9px}.safety-points>div{display:flex;gap:9px;align-items:flex-start;background:rgba(255,255,255,.74);border-radius:14px;padding:10px 12px}.safety-points span{width:25px;height:25px;border-radius:50%;display:grid;place-items:center;color:white;background:#42bd86;font-size:12px;font-weight:950;flex:none}.safety-points p{display:grid;margin:0}.safety-points small{color:#85899e;font-size:10px}
.workspace-section{background:linear-gradient(180deg,#fff,#faf8ff)}.workspace-shell{max-width:1180px;margin:auto;display:grid;grid-template-columns:225px 1fr;background:rgba(255,255,255,.82);backdrop-filter:blur(18px);border:1px solid rgba(88,69,140,.11);border-radius:30px;overflow:hidden;box-shadow:0 32px 80px rgba(74,50,130,.11)}.quest-rail{position:relative;padding:28px 19px;color:white;background:linear-gradient(180deg,#2d2f69,#393a82)}.rail-title{font-size:10px;letter-spacing:.17em;opacity:.62;margin:0 0 18px 10px}.rail-step{width:100%;display:flex;gap:11px;align-items:center;border:0;background:transparent;color:#cecfea;text-align:left;padding:12px;border-radius:15px;cursor:pointer;position:relative;z-index:2}.rail-step>span{width:32px;height:32px;border-radius:11px;display:grid;place-items:center;background:rgba(255,255,255,.1);font-weight:950}.rail-step>div{display:grid}.rail-step b{font-size:13px}.rail-step small{font-size:9px;opacity:.62}.rail-step.active{color:white;background:rgba(255,255,255,.13)}.rail-step.active>span{background:linear-gradient(135deg,#8460ff,#ec60bc)}.rail-progress{position:absolute;left:46px;top:91px;width:2px;height:104px;background:rgba(255,255,255,.12)}.rail-progress i{display:block;width:100%;height:0;background:#ff78c5;transition:.3s}.workspace-main{padding:32px;min-height:650px}.wizard-step{display:none}.wizard-step.active{display:block;animation:panelIn .32s ease both}@keyframes panelIn{from{opacity:0;transform:translateY(9px)}}.panel-head{display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:22px}.panel-head>div:first-child>span{font-size:10px;color:#7650df;letter-spacing:.13em;font-weight:950}.panel-head h3{font-size:27px;margin:2px 0 0}.panel-badge{padding:7px 12px;border-radius:999px;background:#edf0ff;color:#6e4dda;font-size:11px;font-weight:950}.purple-badge{background:#f3eaff;color:#9844db}.orange-badge{background:#fff0df;color:#e57a28}.privacy-inline{display:flex;gap:11px;padding:12px 14px;border-radius:15px;background:#fff8e9;border:1px solid #ffe0a9;margin-bottom:18px;color:#684d26}.privacy-inline>span{font-size:21px}.privacy-inline>div{display:grid}.privacy-inline small{font-size:11px;color:#876d49}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field{display:grid;gap:6px}.field.full{grid-column:1/-1}.field>span{font-weight:900;font-size:13px}.field em{font-size:9px;font-style:normal;color:#e55794}.field small{color:#7b809a;font-weight:500}.field input,.field textarea{width:100%;border:1px solid rgba(71,64,116,.16);background:#fff;color:var(--ink);border-radius:13px;padding:12px 13px;outline:none;transition:.2s;border-color .2s,box-shadow .2s}.field textarea{min-height:94px;resize:vertical}.field input:focus,.field textarea:focus{border-color:#956eff;box-shadow:0 0 0 4px rgba(118,81,255,.09)}.page-pills{display:flex;gap:6px;flex-wrap:wrap}.page-pill{width:40px;height:40px;border-radius:11px;border:1px solid rgba(73,65,119,.14);background:white;color:var(--ink);font-weight:950;cursor:pointer}.page-pill.active{color:white;border-color:transparent;background:linear-gradient(135deg,#7351ff,#d657c0);box-shadow:0 8px 18px rgba(118,81,255,.2)}.save-toggle{margin-top:19px;display:flex;align-items:center;gap:11px;padding:12px 14px;background:#f8f7fb;border-radius:15px;cursor:pointer}.save-toggle input{position:absolute;opacity:0;pointer-events:none}.toggle-ui{width:46px;height:27px;border-radius:999px;background:#d9d7e3;position:relative;transition:.2s;flex:none}.toggle-ui:after{content:"";position:absolute;width:21px;height:21px;top:3px;left:3px;border-radius:50%;background:white;box-shadow:0 2px 6px rgba(0,0,0,.15);transition:.2s}.save-toggle input:checked+.toggle-ui{background:#6c54ec}.save-toggle input:checked+.toggle-ui:after{transform:translateX(19px)}.save-toggle>span:last-child{display:grid}.save-toggle small{color:#7f8397;font-size:10px}.master-visual{padding:18px;border-radius:20px;background:linear-gradient(135deg,#f4efff,#fff5e9);border:1px solid rgba(101,77,165,.08)}.master-flow{display:flex;justify-content:center;align-items:center;gap:9px;flex-wrap:wrap}.master-flow span{background:#fff;border-radius:999px;padding:8px 13px;box-shadow:0 6px 15px rgba(72,52,116,.07);font-weight:950;font-size:12px}.master-flow i{font-style:normal;color:#c481b8}.master-visual p{text-align:center;color:#74788f;font-size:12px;margin:11px 0 0}.next-action{margin-top:17px;padding:13px 15px;border-radius:16px;background:#eef7ff;border:1px solid #d4eafa;display:grid;gap:3px}.next-action span{font-size:9px;letter-spacing:.12em;color:#3c78a2;font-weight:950}.next-action strong{font-size:13px}.prompt-details{margin-top:18px;border:1px solid var(--line);border-radius:16px;background:#fff;overflow:hidden}.prompt-details summary{cursor:pointer;padding:11px 14px;font-weight:900;color:#575d80}.prompt-details pre{white-space:pre-wrap;margin:0;border-top:1px solid var(--line);padding:14px;max-height:280px;overflow:auto;background:#fbfbfe;color:#4a4f70;font-size:11px;line-height:1.65}.render-dashboard{display:flex;align-items:center;gap:28px;padding:21px;border-radius:23px;background:linear-gradient(135deg,#f2edff,#fff7ec)}.render-ring{position:relative;width:126px;height:126px;flex:0 0 126px}.render-ring svg{width:100%;transform:rotate(-90deg)}.render-ring circle{fill:none;stroke-width:9}.ring-bg{stroke:#e4ddec}.ring-value{stroke:#7954ff;stroke-linecap:round;stroke-dasharray:314;stroke-dashoffset:314;transition:.4s}.render-ring>div{position:absolute;inset:0;display:grid;place-content:center;text-align:center}.render-ring strong{font-size:22px}.render-ring small{font-size:9px;color:#83869b}.render-info h4{font-size:21px;margin:0 0 6px}.render-info p{color:var(--muted);margin:0;font-size:13px}.render-dots{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.render-dot{width:20px;height:7px;border-radius:99px;background:#dcd8e8}.render-dot.done{background:linear-gradient(90deg,#6d51ff,#e75eb7)}.render-note{display:flex;gap:10px;align-items:flex-start;margin-top:16px;padding:12px 14px;border-radius:14px;background:#fff7e8;border:1px solid #ffe0ae;color:#6f552e}.render-note span{width:24px;height:24px;border-radius:50%;display:grid;place-items:center;background:#ffb649;color:white;font-weight:950;flex:none}.render-note p{font-size:12px;margin:0}.public-note{padding-top:55px}.public-card{max-width:1120px;margin:auto;padding:34px;border-radius:30px;background:linear-gradient(135deg,#2e306c,#5543a2 60%,#9e48a0);color:white;display:grid;grid-template-columns:1.2fr .8fr;gap:25px;align-items:center;box-shadow:0 28px 72px rgba(60,44,114,.2)}.public-card .kicker{color:#ffd765}.public-card h2{font-size:36px}.public-card p{color:#e8e1fa}.public-card ul{list-style:none;margin:0;padding:0;display:grid;gap:9px}.public-card li{background:rgba(255,255,255,.11);padding:10px 12px;border-radius:12px}.ending{padding-top:55px}.ending-card{max-width:1120px;margin:auto;min-height:360px;border-radius:32px;overflow:hidden;background:linear-gradient(135deg,#fff5e8,#f6efff);display:grid;grid-template-columns:1fr 1fr;align-items:center;box-shadow:var(--shadow)}.ending-copy{padding:45px}.ending-party{height:100%;position:relative;overflow:hidden}.ending-party img{width:145%;height:100%;object-fit:cover;object-position:78% 50%;mix-blend-mode:multiply;mask-image:linear-gradient(to right,transparent,#000 22%);-webkit-mask-image:linear-gradient(to right,transparent,#000 22%)}footer{padding:32px clamp(20px,5vw,78px) calc(32px + env(safe-area-inset-bottom));display:flex;justify-content:space-between;gap:20px;color:#72768c;font-size:11px}footer>div:first-child{display:grid}footer b{color:var(--ink);font-size:14px}.footer-notes{display:flex;flex-wrap:wrap;gap:14px}.mobile-dock{display:none}.toast{position:fixed;z-index:150;right:20px;bottom:calc(20px + env(safe-area-inset-bottom));max-width:min(420px,calc(100vw - 40px));background:#272957;color:white;padding:12px 15px;border-radius:13px;box-shadow:0 16px 38px rgba(32,27,76,.27);opacity:0;transform:translateY(10px);pointer-events:none;transition:.2s}.toast.show{opacity:1;transform:none}.confetti{position:fixed;inset:0;width:100%;height:100%;z-index:140;pointer-events:none}.noscript{position:fixed;inset:auto 10px 10px;z-index:300;background:#812f42;color:#fff;padding:14px;border-radius:12px}.reveal{opacity:0;transform:translateY(20px);transition:.65s ease}.reveal.in{opacity:1;transform:none}
@media(max-width:1120px){.desktop-nav{display:none}.hero{grid-template-columns:1fr;padding-top:130px;min-height:auto}.hero-copy{max-width:780px}.hero-stage{min-height:610px}.party-frame{inset:-15px -7% -2% -16%}.hero-features{max-width:720px}.safety-card{grid-template-columns:auto 1fr}.safety-points{grid-column:1/-1;grid-template-columns:repeat(3,1fr)}}
@media(max-width:760px){body{padding-bottom:78px}.cursor-glow{display:none}.topbar{padding:12px 16px;padding-top:max(12px,env(safe-area-inset-top))}.brand{font-size:15px}.brand-icon{width:32px;height:32px}.top-cta{padding:8px 13px;font-size:12px}.hero{padding:105px 18px 50px}.hero h1{font-size:clamp(40px,12vw,54px)}.hero-lead{font-size:14px}.hero-actions{display:grid;grid-template-columns:1fr 1fr}.btn{min-height:48px;padding:0 14px;font-size:13px}.hero-features{grid-template-columns:1fr}.hero-stage{min-height:450px;margin-top:10px}.party-frame{inset:0 -25% -1% -38%;align-items:center}.party-frame img{width:130%}.hero-arrow{width:82%;right:-10%;top:0}.float-ui{transform:scale(.82);transform-origin:center}.ui-master{left:-4%;top:20%}.ui-check{right:-3%;top:7%}.ui-render{right:-6%;top:48%}.ui-chart{display:none}.section{padding:72px 17px}.section-heading{margin-bottom:30px}.section-heading h2,.safety-card h2,.public-card h2,.ending-copy h2{font-size:32px}.steps-grid{grid-template-columns:1fr}.step-card{min-height:auto}.safety{padding-top:30px;padding-bottom:30px}.safety-card{grid-template-columns:1fr;padding:22px}.safety-icon{font-size:34px}.safety-points{grid-column:auto;grid-template-columns:1fr}.workspace-shell{grid-template-columns:1fr;border-radius:22px}.quest-rail{display:flex;padding:9px;gap:4px;position:sticky;top:62px;z-index:20}.rail-title,.rail-progress{display:none}.rail-step{justify-content:center;padding:8px}.rail-step>div{display:none}.rail-step>span{width:36px;height:36px}.workspace-main{padding:20px;min-height:620px}.panel-head h3{font-size:22px}.panel-badge{display:none}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.field input,.field textarea{font-size:16px}.field textarea{min-height:105px}.page-pill{width:44px;height:44px}.save-toggle{align-items:flex-start}.master-buttons,.render-actions,.panel-actions{display:grid;grid-template-columns:1fr}.render-dashboard{align-items:flex-start;flex-direction:column}.render-ring{margin:auto}.public-card{grid-template-columns:1fr;padding:25px}.ending-card{grid-template-columns:1fr}.ending-copy{padding:30px 24px}.ending-party{height:270px}.footer-notes{display:none}footer{padding:25px 18px calc(105px + env(safe-area-inset-bottom))}.mobile-dock{display:block;position:fixed;z-index:90;left:0;right:0;bottom:0;padding:9px 14px calc(9px + env(safe-area-inset-bottom));background:rgba(255,255,255,.88);backdrop-filter:blur(18px);border-top:1px solid var(--line)}.mobile-dock button{width:100%;min-height:50px;border:0;border-radius:14px;color:white;background:linear-gradient(135deg,#6b51ff,#d656bd);font-weight:950;box-shadow:0 9px 22px rgba(110,80,240,.22)}}
@media(max-width:390px){.hero-actions{grid-template-columns:1fr}.hero-stage{min-height:410px}.party-frame{inset:0 -36% 0 -54%}.ui-render{display:none}.workspace-main{padding:16px}.panel-head{align-items:flex-start}.master-flow i{display:none}}
@media(pointer:coarse){.tilt-card{transform:none!important}.float-ui{transition:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{opacity:1;transform:none;transition:none}.float-ui,.sparkles i{animation:none!important}.btn,.tilt-card{transition:none}.cursor-glow{display:none}}

  </style>
</head>
<body>
  <a class="skip-link" href="#workspace">入力画面へスキップ</a>
  <div class="cursor-glow" aria-hidden="true"></div>
  <div class="ambient-orb orb-1" aria-hidden="true"></div>
  <div class="ambient-orb orb-2" aria-hidden="true"></div>
  <div class="ambient-orb orb-3" aria-hidden="true"></div>

  <header class="topbar" id="topbar">
    <a class="brand" href="#home" aria-label="広報クエスト トップへ">
      <span class="brand-icon" aria-hidden="true">✦</span>
      <span>広報クエスト</span>
    </a>
    <nav class="desktop-nav" aria-label="メインナビゲーション">
      <a href="#how">使い方</a>
      <a href="#safety">安心して使うために</a>
      <a href="#workspace">広報を作る</a>
    </nav>
    <button class="top-cta" type="button" data-scroll="#workspace">はじめる <span>→</span></button>
  </header>

  <main>
    <section class="hero" id="home" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <div class="eyebrow"><span aria-hidden="true">★</span> 院内広報を、もっと創造的に。</div>
        <h1 id="hero-title">
          広報づくりを、<br />
          <span class="gradient-text">もっと楽しく、</span><br />
          <span class="gradient-text alt">もっと分かりやすく。</span>
        </h1>
        <p class="hero-lead">
          テーマと参考資料を入れれば、長いプロンプトはサイト側で組み立てます。
          調査・編集はMASTER、画像づくりはRENDER。読みたくなる院内広報を、迷わず作れるようにします。
        </p>
        <div class="hero-actions">
          <button class="btn btn-primary" type="button" data-scroll="#workspace">広報を作ってみる <b aria-hidden="true">→</b></button>
          <button class="btn btn-soft" type="button" data-scroll="#how">使い方を見る <b aria-hidden="true">▶</b></button>
        </div>
        <div class="hero-features" aria-label="主な機能">
    